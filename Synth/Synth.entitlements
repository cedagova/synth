<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read-only: importing copies the score into Synth's own container and
	     never writes back to the file the owner picked or dropped (D9). -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Outbound only, and only ever used to GET the instrument-catalog assets
	     this build pins by URL and checksum (INS001, REQ-020/REQ-022). There is
	     deliberately no com.apple.security.network.server: Synth accepts no
	     incoming connections. Nothing is uploaded — no account, no telemetry,
	     no user data leaves the machine (REQ-028, D9).
	     NoNetworkBaselineTests asserts exactly this pair of facts. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
