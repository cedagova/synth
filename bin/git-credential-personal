#!/bin/sh
# Git credential helper: serves a 'cedagova' token for github.com only.
# This repository is always worked on as the GitHub account 'cedagova'. See bin/README.md.

set -eu

operation="${1:-}"
protocol=""
host=""
username=""

while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
    username) username="$value" ;;
  esac
done

case "$operation" in
  get)
    if [ "$protocol" != "https" ] || [ "$host" != "github.com" ]; then
      echo "Credential request blocked: expected https://github.com." >&2
      exit 1
    fi

    if [ -n "$username" ] && [ "$username" != "cedagova" ]; then
      echo "Credential request blocked: expected GitHub user cedagova." >&2
      exit 1
    fi

    personal_token="$(gh auth token --hostname github.com --user cedagova)"
    printf 'username=cedagova\npassword=%s\n\n' "$personal_token"
    ;;
  store | erase)
    # The credential remains in the GitHub CLI keyring; never duplicate it.
    ;;
  *)
    echo "Unsupported credential-helper operation: $operation" >&2
    exit 1
    ;;
esac
