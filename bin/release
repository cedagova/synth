#!/bin/sh
# Cut a Synth release: verify a clean, up-to-date main, tag it, push the tag.
# The Release workflow (.github/workflows/release.yml) does the rest:
# tests -> Release build -> ad-hoc sign -> DMG/zip/checksums -> GitHub Release.
#
# Usage: bin/release 1.2.0

set -eu

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

version="${1:-}"
case "$version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *)
    echo "Usage: bin/release X.Y.Z   (e.g. bin/release 1.2.0)" >&2
    exit 2
    ;;
esac
tag="v$version"

if [ -n "$(git status --porcelain)" ]; then
  echo "Working tree is not clean; commit or stash first." >&2
  exit 1
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" != "main" ]; then
  echo "Releases are cut from main; you are on '$branch'." >&2
  exit 1
fi

git fetch origin main
if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
  echo "Local main is not in sync with origin/main; pull or push first." >&2
  exit 1
fi

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "Tag $tag already exists." >&2
  exit 1
fi

git tag -a "$tag" -m "Synth $version"
git push origin "$tag"

echo
echo "Tag $tag pushed. The Release workflow is building now:"
echo "  https://github.com/cedagova/synth/actions/workflows/release.yml"
echo "When it finishes, the release appears at:"
echo "  https://github.com/cedagova/synth/releases/tag/$tag"
